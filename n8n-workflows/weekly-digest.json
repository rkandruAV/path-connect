{
  "name": "Weekly Digest Email",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Monday 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_INTERNAL_URL || 'http://api:4000' }}/api/v1/webhooks/weekly-digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $env.WEBHOOK_SECRET || 'dev-webhook-secret' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-digest",
      "name": "Fetch Weekly Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "id": "check-count",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-users",
      "name": "Has Active Users?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-users",
      "name": "Split Into Users",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [910, 200]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM || 'noreply@pathconnect.app' }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Your PathConnect weekly summary",
        "emailType": "text",
        "message": "=Hi {{ $json.displayName || 'there' }},\n\nHere's your week in review:\n\n--- This Week ---\n- Sessions: {{ $json.sessionsThisWeek }} ({{ $json.completedSessions }} completed)\n- Upcoming sessions: {{ $json.upcomingSessions }}\n- Goals updated: {{ $json.goalsUpdated }}\n- Goals achieved: {{ $json.goalsAchieved }}\n- Week streak: {{ $json.weekStreak }} weeks\n\n{{ $json.goalsAchieved > 0 ? 'Congratulations on achieving ' + $json.goalsAchieved + ' goal(s) this week!' : 'Keep pushing toward your goals — you got this!' }}\n\nVisit your dashboard: {{ $env.FRONTEND_URL || 'http://localhost:3000' }}/dashboard\n\nBest,\nPathConnect"
      },
      "id": "email-digest",
      "name": "Send Digest Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1130, 200]
    },
    {
      "parameters": {},
      "id": "no-users",
      "name": "No Active Users",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [910, 400]
    }
  ],
  "connections": {
    "Every Monday 9 AM": {
      "main": [[{ "node": "Fetch Weekly Data", "type": "main", "index": 0 }]]
    },
    "Fetch Weekly Data": {
      "main": [[{ "node": "Has Active Users?", "type": "main", "index": 0 }]]
    },
    "Has Active Users?": {
      "main": [
        [{ "node": "Split Into Users", "type": "main", "index": 0 }],
        [{ "node": "No Active Users", "type": "main", "index": 0 }]
      ]
    },
    "Split Into Users": {
      "main": [
        [{ "node": "Send Digest Email", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "pathconnect" }]
}
